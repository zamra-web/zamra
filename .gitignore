.env*.local

# Dependencies
node_modules/
functions/node_modules/
web/node_modules/
mobile/node_modules/

# Build outputs
web/dist
mobile/dist/

# Android signing — losing these means never being able to ship an update to an
# already-installed app. Keep an off-machine backup; see mobile/README.md.
mobile/android/keystore.properties
mobile/android/*.jks
mobile/android/*.keystore

# Firebase/Vercel caches
.firebase/
web/.firebase/
.vercel/
web/.vercel/
firebase-debug*.log

# Claude Code internal state
.claude/

# OS junk
.DS_Store
