# Copy to .env next to the compose file on the VPS. Never commit real values.
#
#   KEY=$(uuidgen | tr -d '-')                        # the plaintext API key
#   echo -n "$KEY" | shasum -a 512 | cut -d' ' -f1     # -> WAHA_API_KEY_SHA512
#
# The plaintext KEY goes into the WAHA_API_KEY Firebase secret and the n8n
# "WAHA API" credential. Only the hash goes on the box.

WAHA_API_KEY_SHA512=
WAHA_DASHBOARD_USERNAME=zamra
WAHA_DASHBOARD_PASSWORD=
