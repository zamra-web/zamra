{
  "name": "Zamra WhatsApp Rate Intake",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 3
            }
          ]
        }
      },
      "id": "intake-schedule",
      "name": "Intake Schedule",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -256,
        304
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://asia-south1-zamra-web-01.cloudfunctions.net/whatsappRateIntakeForN8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'claim', limit: 2 }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "claim-batches",
      "name": "Claim Batches",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -48,
        304
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qu93czX3nEMrFcId",
          "name": "Zamra Ingest"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// Fan one claim response out into one item per batch.\n//\n// Returns [] when the queue is empty, which ends the run with no IF node — an\n// empty item list means nothing downstream executes at all.\nconst batches = $json.batches || [];\nreturn batches.map((batch) => ({ json: batch }));\n"
      },
      "id": "split-batches",
      "name": "Split Batches",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        192,
        304
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "loop-batches",
      "name": "Loop Batches",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        400,
        304
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-media",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "leftValue": "={{ ($json.media || []).length }}",
              "rightValue": 0
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "has-media",
      "name": "Has Media?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        624,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// One item per image, carrying the batch it belongs to.\n//\n// The claim response gives a PATH, never a URL. wahaMediaPath() in the Cloud\n// Function already allow-listed it to /api/files/, because n8n shares a Docker\n// network with Traefik and WAHA — a URL followed verbatim from a webhook\n// payload would be an SSRF primitive aimed inside the trusted network. Keep\n// the host here, in the workflow, where it is visible.\nconst batch = $json;\nreturn (batch.media || []).map((item, index) => ({\n  json: {\n    batchId: batch.batchId,\n    path: item.path,\n    mimetype: item.mimetype,\n    name: `whatsapp-${index + 1}.${(item.mimetype || 'image/jpeg').split('/')[1] || 'jpg'}`,\n    likelyExpired: item.likelyExpired === true,\n  },\n}));\n"
      },
      "id": "media-to-items",
      "name": "Media To Items",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        848,
        288
      ]
    },
    {
      "parameters": {
        "url": "=http://waha:3000{{ $json.path }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          },
          "timeout": 30000
        }
      },
      "id": "download-media",
      "name": "Download Media",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1072,
        288
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpHeaderAuth": {
          "id": "Y0BviX1miU1T3qMe",
          "name": "WAHA Header Auth"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "binaryToPropery",
        "destinationKey": "b64",
        "options": {}
      },
      "id": "encode-media",
      "name": "Encode Media",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1,
      "position": [
        1280,
        288
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {},
      "id": "no-media",
      "name": "No Media",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1072,
        480
      ]
    },
    {
      "parameters": {},
      "id": "merge-media",
      "name": "Merge Media",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        1504,
        384
      ]
    },
    {
      "parameters": {
        "jsCode": "// Assemble the EXACT payload the zamra-rates webhook already takes.\n//\n// This workflow does not extract anything. It hands the batch to the same\n// workflow the Rate Upload tab posts to, so the vision prompt, the closed\n// sector/airline vocabulary, the direction and connection guards and the rate band exist\n// in exactly one place. functions/tests/n8n-workflow.test.js asserts this\n// object against the same fixture Build Vision Request consumes — if the two\n// contracts drift, that test fails rather than production.\nconst MAX_IMAGES = 10;\nconst MAX_TOTAL_BYTES = 12 * 1024 * 1024;\n\nconst batch = $('Loop Batches').first().json;\n\n// The No Media branch forwards the BATCH OBJECT itself, not a file. Without\n// this guard it falls through to the !data check below and is recorded as\n// 'download failed', so a text-only sheet reported a screenshot nobody sent.\n// Observed on execution 1173. Files only exist when the batch had media.\nconst incoming = (batch.media || []).length > 0 ? $input.all() : [];\n\nconst images = [];\nconst skipped = [];\nlet totalBytes = 0;\n\nfor (const item of incoming) {\n  const data = item.json.b64;\n  if (!data) {\n    // Download or encode failed for this one file. Continue: five good\n    // screenshots must not be lost because a sixth expired out of WAHA.\n    skipped.push({ name: item.json.name, reason: 'download failed' });\n    continue;\n  }\n  if (images.length >= MAX_IMAGES) {\n    skipped.push({ name: item.json.name, reason: 'image cap' });\n    continue;\n  }\n  // base64 inflates ~33%; budget against the encoded size, the way the portal\n  // does, because that is what actually crosses the wire.\n  const bytes = Math.ceil(data.length * 0.75);\n  if (totalBytes + bytes > MAX_TOTAL_BYTES) {\n    skipped.push({ name: item.json.name, reason: 'size cap' });\n    continue;\n  }\n  totalBytes += bytes;\n  images.push({\n    name: item.json.name,\n    mime_type: item.json.mimetype === 'image/jpg' ? 'image/jpeg' : item.json.mimetype,\n    size: bytes,\n    data,\n  });\n}\n\nreturn [{\n  json: {\n    agent_id: batch.agentId,\n    raw_text: batch.rawText || '',\n    parsed_rows: [],\n    parsed_count: 0,\n    images,\n    image_count: images.length,\n    timestamp: new Date().toISOString(),\n    source: 'whatsapp-intake',\n    batch_id: batch.batchId,\n    skipped_images: skipped,\n  },\n}];\n"
      },
      "id": "build-rate-payload",
      "name": "Build Rate Payload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1728,
        384
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:5678/webhook/zamra-rates",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 480000
        }
      },
      "id": "extract-rates",
      "name": "Extract Rates",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1952,
        384
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "ingest-ok",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              },
              "leftValue": "={{ $json.success }}"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ingest-succeeded",
      "name": "Ingest Succeeded?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        2160,
        384
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://asia-south1-zamra-web-01.cloudfunctions.net/whatsappRateIntakeForN8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'complete', batchId: $('Loop Batches').first().json.batchId, status: ($json.saved > 0 ? 'done' : 'empty'), saved: $json.saved || 0, notes: $json.notes || '', rejected: $json.rejected || [], skippedImages: ($('Build Rate Payload').first().json.skipped_images || []).concat($json.skipped_images || []), n8nExecutionId: $execution.id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "complete-batch",
      "name": "Complete Batch",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2384,
        288
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qu93czX3nEMrFcId",
          "name": "Zamra Ingest"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://asia-south1-zamra-web-01.cloudfunctions.net/whatsappRateIntakeForN8n",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: 'complete', batchId: $('Loop Batches').first().json.batchId, status: 'failed', saved: 0, error: ($json.error?.message || $json.error || 'Extraction failed'), n8nExecutionId: $execution.id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "complete-failed",
      "name": "Complete Failed",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2384,
        512
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "credentials": {
        "httpHeaderAuth": {
          "id": "qu93czX3nEMrFcId",
          "name": "Zamra Ingest"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
