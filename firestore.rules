rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ─────────────────────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && 'admin' in request.auth.token
        && request.auth.token.admin != null
        && request.auth.token.admin != false
        && request.auth.token.admin != 0
        && request.auth.token.admin != '';
    }

    function isAgent() {
      return isAuthenticated()
        && request.auth.token.agent == true
        && request.auth.token.b2bAgentId is string;
    }

    // ── admins ───────────────────────────────────────────────────────────────
    // Only admins can read/write other admin docs
    match /admins/{uid} {
      allow read, write: if isAdmin();
    }

    // ── agents ───────────────────────────────────────────────────────────────
    // Rate SUPPLIERS (consolidators Zamra buys from) — not B2B customers, which
    // are `b2b_agents`. Admin-only both ways: the supplier list is commercially
    // sensitive (it names who Zamra sources from), and nothing outside the admin
    // dashboard reads it. `getAgents()` is called only from admin/main.js; the
    // public site and the B2B portal never touch this collection, and the poster
    // and report functions read it through the Admin SDK, which bypasses rules.
    match /agents/{agentId} {
      allow read, write: if isAdmin();
    }

    // ── b2b_agents ───────────────────────────────────────────────────────────
    // B2B portal agents. Admin-managed; an agent may read only their own doc.
    // Fares/pricing are never served from here — see getB2BFares Cloud Function.
    match /b2b_agents/{agentId} {
      allow read: if isAdmin() || (isAgent() && request.auth.token.b2bAgentId == agentId);
      allow write: if isAdmin();
    }

    // ── b2b_offers ───────────────────────────────────────────────────────────
    // Featured promo cards shown beside the portal's welcome banner. Managed in
    // the admin dashboard and served to agents by getB2BPortalContext, which
    // runs on the Admin SDK — so agents need no direct read here, and expiry
    // stays enforced server-side rather than by whatever a stale tab believes.
    match /b2b_offers/{offerId} {
      allow read, write: if isAdmin();
    }

    // ── b2b_credentials ──────────────────────────────────────────────────────
    // Encrypted copies of B2B agent passwords, kept so admins can re-read an
    // agent's current credentials (Firebase Auth cannot give a password back).
    //
    // Denied to EVERY client, admins included: the only reader is the
    // getB2BAgentCredentials callable, which runs on the Admin SDK and bypasses
    // these rules. Keeping it out of b2b_agents matters because that doc is
    // readable by the agent it belongs to.
    match /b2b_credentials/{agentId} {
      allow read, write: if false;
    }

    // ── sectors ──────────────────────────────────────────────────────────────
    // Public can read sectors; only admins can write
    match /sectors/{sectorId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── airlines ─────────────────────────────────────────────────────────────
    // Public can read airlines; only admins can write
    match /airlines/{airlineId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── flight_details ───────────────────────────────────────────────────────
    // Public can read flight details; only admins can write
    match /flight_details/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── agent_fares ──────────────────────────────────────────────────────────
    // Admin-only, both ways.
    //
    // This was once `allow read: if isAdmin() || resource.data.isHidden == false`
    // so the public site could query it directly. Firestore returns whole
    // documents and has no field-level security, so that handed every anonymous
    // caller `specialRate`, `commission` and the supplier `agentId` — Zamra's
    // buying rate, its margin, and who it sources each route from — while the
    // page displayed only `finalRate`.
    //
    // Every public reader now goes through a projecting endpoint on the Admin
    // SDK: getPublicFares for the homepage/search list, getPublicDeals for
    // /deals/<slug>, getB2BFares for the partner portal. Re-opening this rule
    // would undo all three.
    match /agent_fares/{fareId} {
      allow read, write: if isAdmin();
    }

    // ── enquiries ────────────────────────────────────────────────────────────
    // Internal log of customer fare requests. Holds customer names and phone
    // numbers, so it is never public — admin only, both ways.
    match /enquiries/{enquiryId} {
      allow read, write: if isAdmin();
    }

    // ── deal_links ───────────────────────────────────────────────────────────
    // Curated public deal pages (/deals/<slug>). The doc id IS the slug.
    //
    // Admin-only from the client. The public page never touches Firestore — it
    // calls the getPublicDeals endpoint, which reads through the Admin SDK and
    // returns fares projected down to display fields. That keeps specialRate /
    // commission / supplier agentId off the wire, and lets the endpoint own the
    // view counter rather than exposing a publicly writable field here.
    match /deal_links/{slug} {
      allow read, write: if isAdmin();
    }

    // ── soto_cache ───────────────────────────────────────────────────────────
    // Cached third-party fare lookups for /soto. Server-only, like deal_links:
    // the public path is the searchSotoFares endpoint, not the collection.
    //
    // Denied to every client including admins. Nothing reads these except the
    // Admin SDK inside the endpoint, and a client-writable cache in front of a
    // metered API is an obvious way to poison prices or burn the quota.
    // purgeSotoCache sweeps expired entries daily.
    match /soto_cache/{cacheId} {
      allow read, write: if false;
    }

    // ── whatsapp_messages ────────────────────────────────────────────────────
    // The Firestore mirror of the WAHA inbox, so /admin/whatsapp can read the
    // conversation live instead of polling the VPS.
    //
    // Readable by admins, writable by nobody — including admins. The only
    // writers are whatsappWebhook and sendWhatsappMessage, both on the Admin
    // SDK. A browser-writable message log would let anyone with the dashboard
    // open forge a customer's own words in the record staff then act on, which
    // is a different and worse problem than editing Zamra's own content.
    match /whatsapp_messages/{messageId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── whatsapp_chats ───────────────────────────────────────────────────────
    // One doc per conversation: the derived summary (last message, counts) plus
    // the triage state the inbox owns (unread, assignee, status, tags).
    //
    // Same server-writes-only stance as whatsapp_messages, with one deliberate
    // carve-out: the triage fields are pure UI state with no security value,
    // and routing them through a callable would cost another Cloud Run service
    // and a round-trip on every chat click. The hasOnly clause is what keeps
    // that narrow — without it this would be a full write, letting the client
    // rewrite lastMessageBody and the mirror's own derived fields.
    match /whatsapp_chats/{chatId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['unreadCount', 'assignedTo', 'status', 'tags', 'updatedAt']);
      allow create, delete: if false;
    }

    // ── whatsapp_meta ────────────────────────────────────────────────────────
    // Per-minute outbound send counters, a brake against a runaway loop banning
    // the number. Denied to every client: a writable rate limit is not one.
    match /whatsapp_meta/{metaId} {
      allow read, write: if false;
    }

    // ── whatsapp_rate_batches ────────────────────────────────────────────────
    // One doc per group of supplier messages handed to the n8n extraction
    // workflow, with the saved count and any rejections that came back. It is
    // the audit trail for fares nobody clicked Submit on, so the dashboard
    // reads it — but writing it would let a browser mark a batch "done" and
    // hide an ingestion that actually failed. The only writers are
    // whatsappRateIntakeForN8n and dailyMaintenance, both on the Admin SDK.
    match /whatsapp_rate_batches/{batchId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ── services ─────────────────────────────────────────────────────────────
    // Public can read active services; only admins can write
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── visas ────────────────────────────────────────────────────────────────
    match /visas/{visaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── visa_rate_cards ──────────────────────────────────────────────────────
    // Structured tourist-visa price sheets shown behind the "Details" button in
    // the B2B portal. These are agent rates, so unlike `visas` they are NOT
    // world-readable — only an admin or a signed-in B2B agent may read them.
    match /visa_rate_cards/{id} {
      allow read: if isAdmin() || isAgent();
      allow write: if isAdmin();
    }

    // ── visa_stamping ────────────────────────────────────────────────────────
    match /visa_stamping/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── attestations ─────────────────────────────────────────────────────────
    match /attestations/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── passport_services ────────────────────────────────────────────────────
    match /passport_services/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── tours ─────────────────────────────────────────────────────────────────
    match /tours/{tourId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── hajj_umrah_packages ───────────────────────────────────────────────────
    match /hajj_umrah_packages/{pkgId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── config ────────────────────────────────────────────────────────────────
    // Admin-managed operational config (e.g. social publishing health/channel ids)
    //
    // config/b2b_secure is carved out: it holds the key that encrypts the
    // b2b_credentials copies, and rules are OR-ed across matches, so a separate
    // `match /config/b2b_secure { allow read: if false }` would NOT override an
    // allow here — the exclusion has to live in this condition.
    match /config/{configId} {
      allow read, write: if isAdmin() && configId != 'b2b_secure';
    }

    // ── social_queue ──────────────────────────────────────────────────────────
    // Internal queue items for Buffer publishing
    match /social_queue/{itemId} {
      allow read, write: if isAdmin();
    }

    // ── social_jobs ───────────────────────────────────────────────────────────
    // Operator-visible publishing jobs + per-item history
    match /social_jobs/{jobId} {
      allow read, write: if isAdmin();

      match /items/{itemId} {
        allow read, write: if isAdmin();
      }
    }

  }
}
