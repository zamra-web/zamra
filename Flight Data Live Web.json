    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst flights = [];\n\n// Count how many flights we extracted based on the Price array\nconst numFlights = data.Price ? data.Price.length : 0;\n\n// Loop through and format everything cleanly\nfor (let i = 0; i < numFlights; i++) {\n  \n  // Extract Airline Name from the image URL (e.g., 'css2/.../Air India.png' -> 'Air India')\n  let rawSrc = data.AirlineSrc[i] || \"\";\n  let airlineName = rawSrc.split('/').pop().replace('.png', '').trim();\n  \n  flights.push({\n    json: {\n      airline: airlineName,\n      origin: data.Origin[i] ? data.Origin[i].trim() : \"\",\n      destination: data.Destination[i] ? data.Destination[i].trim() : \"\",\n      price: data.Price[i] ? data.Price[i].trim().replace(/\\s+/g, ' ') : \"\",\n      seats: data.Seats[i] ? data.Seats[i].trim() : \"\",\n      luggage: data.Luggage[i] ? data.Luggage[i].trim() : \"\"\n    }\n  });\n}\n\nreturn flights;"
      },
