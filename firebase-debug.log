[debug] [2026-03-16T06:41:59.626Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/zamra-web-01/rulesets {"name":"projects/zamra-web-01/rulesets/404747bc-a63c-46a3-9138-b90666394ed7","source":{"files":[{"content":"rules_version = '2';\n\nservice firebase.storage {\n  match /b/{bucket}/o {\n\n    // ── Helper Functions ─────────────────────────────────────────────────────\n    function isAdmin() {\n      return request.auth != null && request.auth.token.admin == true;\n    }\n\n    // Validate image uploads: must be image type, max 5MB\n    function isValidImage() {\n      return request.resource.contentType.matches('image/.*')\n          && request.resource.size < 5 * 1024 * 1024;\n    }\n\n    // ── Agent Logos ──────────────────────────────────────────────────────────\n    match /agent_logos/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin() && isValidImage();\n    }\n\n    // ── Airline Logos ────────────────────────────────────────────────────────\n    match /airline_logos/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin() && isValidImage();\n    }\n\n    // ── Country Flags ─────────────────────────────────────────────────────────\n    match /country_flags/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin() && isValidImage();\n    }\n\n    // ── Generated Posters ────────────────────────────────────────────────────\n    // Posters are generated by Cloud Functions — still need admin to overwrite manually\n    match /generated_posters/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── Tour Images ───────────────────────────────────────────────────────────\n    match /tour_images/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin() && isValidImage();\n    }\n\n    // ── Hajj & Umrah Images ───────────────────────────────────────────────────────\n    match /hajj_umrah_images/{fileName} {\n      allow read: if true;\n      allow write: if isAdmin() && isValidImage();\n    }\n\n  }\n}\n","name":"storage.rules"}]},"createTime":"2026-03-16T06:41:59.563535Z","metadata":{"services":["firebase.storage"]}}
