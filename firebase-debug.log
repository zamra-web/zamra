[debug] [2026-03-16T06:42:01.292Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/zamra-web-01/rulesets {"name":"projects/zamra-web-01/rulesets/0c8ee70c-b97d-4a66-b16b-2bbd35f25c26","source":{"files":[{"content":"rules_version = '2';\n\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ── Helper Functions ─────────────────────────────────────────────────────\n    function isAuthenticated() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return isAuthenticated() && request.auth.token.admin == true;\n    }\n\n    // ── admins ───────────────────────────────────────────────────────────────\n    // Only admins can read/write other admin docs\n    match /admins/{uid} {\n      allow read, write: if isAdmin();\n    }\n\n    // ── agents ───────────────────────────────────────────────────────────────\n    // Public can read active agents; only admins can write\n    match /agents/{agentId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── sectors ──────────────────────────────────────────────────────────────\n    // Public can read sectors; only admins can write\n    match /sectors/{sectorId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── airlines ─────────────────────────────────────────────────────────────\n    // Public can read airlines; only admins can write\n    match /airlines/{airlineId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── agent_fares ──────────────────────────────────────────────────────────\n    // Public: can only read fares that are NOT hidden (isHidden == false)\n    // Admins: full read/write including hidden records\n    match /agent_fares/{fareId} {\n      allow read: if isAdmin() || resource.data.isHidden == false;\n      allow write: if isAdmin();\n    }\n\n    // ── services ─────────────────────────────────────────────────────────────\n    // Public can read active services; only admins can write\n    match /services/{serviceId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── visas ────────────────────────────────────────────────────────────────\n    match /visas/{visaId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── visa_stamping ────────────────────────────────────────────────────────\n    match /visa_stamping/{id} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── attestations ─────────────────────────────────────────────────────────\n    match /attestations/{id} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── passport_services ────────────────────────────────────────────────────\n    match /passport_services/{id} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── tours ─────────────────────────────────────────────────────────────────\n    match /tours/{tourId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n    // ── hajj_umrah_packages ───────────────────────────────────────────────────\n    match /hajj_umrah_packages/{pkgId} {\n      allow read: if true;\n      allow write: if isAdmin();\n    }\n\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-03-16T06:42:01.231055Z","metadata":{"services":["cloud.firestore"]}}
