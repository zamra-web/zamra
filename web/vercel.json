{
    "cleanUrls": true,
    "trailingSlash": false,
    "redirects": [
        {
            "source": "/",
            "has": [{ "type": "host", "value": "b2b.zamratravels.com" }],
            "destination": "/b2b-login",
            "permanent": false
        },
        {
            "source": "/b2b(.*)",
            "missing": [{ "type": "host", "value": "b2b.zamratravels.com" }],
            "destination": "https://b2b.zamratravels.com/b2b$1",
            "permanent": false
        }
    ],
    "rewrites": [
        {
            "source": "/admin(.*)",
            "destination": "/admin"
        },
        {
            "source": "/gcc",
            "destination": "/connect"
        },
        {
            "source": "/deals/(.*)",
            "destination": "/deals"
        }
    ]
}
