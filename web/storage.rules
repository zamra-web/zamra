rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Helper Functions ─────────────────────────────────────────────────────
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Validate image uploads: must be image type, max 5MB
    function isValidImage() {
      return request.resource.contentType.matches('image/.*')
          && request.resource.size < 5 * 1024 * 1024;
    }

    // ── Agent Logos ──────────────────────────────────────────────────────────
    match /agent_logos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ── Airline Logos ────────────────────────────────────────────────────────
    match /airline_logos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isValidImage();
    }

    // ── Generated Posters ────────────────────────────────────────────────────
    // Posters are generated by Cloud Functions — still need admin to overwrite manually
    match /generated_posters/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
